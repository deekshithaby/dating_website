# Copy to `.env.local` and fill in. Do not commit `.env.local`.

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never use NEXT_PUBLIC_ for this key; do not import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-compatible uploads; optional until photo upload is wired)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Phone OTP is sent by Supabase (not this repo). Set SMS in the Supabase Dashboard:
# Authentication → Providers → Phone (Twilio / MessageBird / Textlocal / Vonage) or Send SMS Hook.
# If you see Twilio error 20003 on login, fix Account SID + Auth Token there (or use a hook + Fast2SMS).

# Edge Function secrets (`supabase secrets set` — not in Next.js):
# FAST2SMS_API_KEY=
# SEND_SMS_HOOK_SECRET=  # must match Auth Hook “secret”; Auth calls the function with Authorization: Bearer <this>
FAST2SMS_API_KEY=
